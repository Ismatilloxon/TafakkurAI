# ---- Runtime ----
ENV=dev
HTTP_PORT=8080

# ---- Database ----
DATABASE_URL=postgres://tafakkur:tafakkur@localhost:5432/tafakkur?sslmode=disable
MIGRATIONS_DIR=migrations

# ---- JWT (CHANGE THESE) ----
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_ISSUER=tafakkur
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- Where this server is reachable from a browser ----
# Builds the Google redirect URI (<base>/v1/auth/google/callback), which must be
# registered verbatim in the Google Cloud console. Blank = http://localhost:$HTTP_PORT.
PUBLIC_BASE_URL=

# ---- Identity providers ----
# Google: every client id whose ID tokens this server accepts, comma-separated.
# Google issues one per platform (iOS / Android / Web) and `aud` is whichever
# minted the token, so list all the ones you use. Only needed for native SDK
# sign-in — the browser flow below adds its own client id automatically.
GOOGLE_CLIENT_ID=
# Google browser sign-in ("Web application" OAuth client — the only kind with a
# secret). With these two set, POST /v1/auth/google/start works and the app needs
# no Google SDK. Authorised redirect URI: $PUBLIC_BASE_URL/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_STATE_TTL=10m
# Apple: your app bundle id (aud of the Apple identity token). Must equal
# PRODUCT_BUNDLE_IDENTIFIER in iosApp/Configuration/Config.xcconfig.
APPLE_BUNDLE_ID=

# ---- Phone OTP (Twilio). If blank, codes are printed to logs (DEV ONLY). ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Telegram bot sign-in. Create a bot with @BotFather, paste its token here.
# Leave TELEGRAM_WEBHOOK_BASE empty for local dev: the server long-polls instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_BASE=
TELEGRAM_WEBHOOK_SECRET=

OTP_TTL=5m
OTP_MAX_ATTEMPTS=5

# ---- Anthropic / Claude (server-side only, never sent to the client) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_DEEP_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=1024
ANTHROPIC_VERSION=2023-06-01

# ---- Object storage (S3 / MinIO). If blank, photo upload returns 503. ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tafakkur-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_PUBLIC_BASE=http://localhost:9000/tafakkur-media

# ---- CORS (comma-separated). Mobile clients don't send Origin; add web here. ----
CORS_ALLOWED_ORIGINS=

# ---- Rate limits (requests per minute per key) ----
RATE_AUTH_PER_MIN=20
RATE_COACH_PER_MIN=15
RATE_POST_PER_MIN=30
