# Copy to .env.production on the trusted server, set mode 600, and fill values
# there. Empty optional values disable their feature. Never commit the copy.

# Public HTTPS and ACME (required by compose.production.yml)
API_DOMAIN=
ACME_EMAIL=

# PostgreSQL (required; generate independent lowercase hex passwords, 32+ characters)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=

# Direct-process runtime. Compose derives DATABASE_URL from POSTGRES_* above.
ENV=
PORT=
DATABASE_URL=
MIGRATIONS_DIR=
AUTO_MIGRATE=

# JWT (JWT_SECRET must be at least 32 characters in production)
JWT_SECRET=
JWT_ISSUER=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
PUBLIC_BASE_URL=

# Browser/web origins only. Native mobile clients normally send no Origin.
CORS_ALLOWED_ORIGINS=

# Google and Apple identity
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_STATE_TTL=
APPLE_BUNDLE_ID=

# Phone OTP. All three are required together; otherwise phone auth is disabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OTP_TTL=
OTP_MAX_ATTEMPTS=

# Telegram. In production all three are required together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_BASE=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CODE_TTL=

# AI coach
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_DEEP_MODEL=
CLAUDE_MAX_TOKENS=
ANTHROPIC_VERSION=

# S3-compatible media storage. Leave all credential fields empty to disable.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=
S3_PUBLIC_BASE=

# Rate limits
RATE_AUTH_PER_MIN=
RATE_COACH_PER_MIN=
RATE_POST_PER_MIN=
RATE_SYNC_PER_MIN=

# Host backup job; these are not injected into the API container.
BACKUP_RETENTION_DAYS=
OCI_BACKUP_BUCKET=
OCI_BACKUP_NAMESPACE=
OCI_BACKUP_REGION=
OCI_CLI_AUTH=
