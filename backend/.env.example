# ---- Runtime ----
ENV=dev
HTTP_PORT=8080

# ---- Database ----
DATABASE_URL=postgres://tafakkur:tafakkur@localhost:5432/tafakkur?sslmode=disable
MIGRATIONS_DIR=migrations

# ---- JWT (CHANGE THESE) ----
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_ISSUER=tafakkur
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- Identity providers ----
# Google: the OAuth client id the mobile app uses (aud of the Google ID token).
GOOGLE_CLIENT_ID=
# Apple: your app bundle id (aud of the Apple identity token).
APPLE_BUNDLE_ID=

# ---- Phone OTP (Twilio). If blank, codes are printed to logs (DEV ONLY). ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5

# ---- Anthropic / Claude (server-side only, never sent to the client) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_DEEP_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=1024
ANTHROPIC_VERSION=2023-06-01

# ---- Object storage (S3 / MinIO). If blank, photo upload returns 503. ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tafakkur-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_PUBLIC_BASE=http://localhost:9000/tafakkur-media

# ---- CORS (comma-separated). Mobile clients don't send Origin; add web here. ----
CORS_ALLOWED_ORIGINS=

# ---- Rate limits (requests per minute per key) ----
RATE_AUTH_PER_MIN=20
RATE_COACH_PER_MIN=15
RATE_POST_PER_MIN=30
