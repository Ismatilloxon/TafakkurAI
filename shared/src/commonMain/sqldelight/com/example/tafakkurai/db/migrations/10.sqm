-- v10 → v11: local-first Finance and Social source-of-truth tables.

CREATE TABLE IF NOT EXISTS financeTransaction (
    id           TEXT NOT NULL PRIMARY KEY,
    kind         TEXT NOT NULL,
    amountMinor  INTEGER NOT NULL,
    currencyCode TEXT NOT NULL,
    categoryId   TEXT NOT NULL,
    note         TEXT NOT NULL DEFAULT '',
    entryDate    TEXT NOT NULL,
    occurredAt   INTEGER NOT NULL,
    createdAt    INTEGER NOT NULL,
    updatedAt    INTEGER NOT NULL,
    deleted      INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS financeTransaction_date
    ON financeTransaction(deleted, entryDate DESC, occurredAt DESC);

CREATE TABLE IF NOT EXISTS financeBudget (
    id           TEXT NOT NULL PRIMARY KEY,
    monthKey     TEXT NOT NULL,
    categoryId   TEXT NOT NULL,
    limitMinor   INTEGER NOT NULL,
    currencyCode TEXT NOT NULL,
    createdAt    INTEGER NOT NULL,
    updatedAt    INTEGER NOT NULL,
    deleted      INTEGER NOT NULL DEFAULT 0,
    UNIQUE(monthKey, categoryId, currencyCode)
);
CREATE INDEX IF NOT EXISTS financeBudget_month
    ON financeBudget(deleted, monthKey, currencyCode);

CREATE TABLE IF NOT EXISTS socialCircleMembership (
    circleId  TEXT NOT NULL PRIMARY KEY,
    joined    INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS socialConnection (
    id              TEXT NOT NULL PRIMARY KEY,
    name            TEXT NOT NULL,
    relationshipId  TEXT NOT NULL,
    lastContactDate TEXT NOT NULL DEFAULT '',
    createdAt       INTEGER NOT NULL,
    updatedAt       INTEGER NOT NULL,
    deleted         INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS socialConnection_active
    ON socialConnection(deleted, lastContactDate DESC, name);

CREATE TABLE IF NOT EXISTS socialCheckIn (
    id           TEXT NOT NULL PRIMARY KEY,
    connectionId TEXT NOT NULL,
    note         TEXT NOT NULL DEFAULT '',
    dateKey      TEXT NOT NULL,
    createdAt    INTEGER NOT NULL,
    deleted      INTEGER NOT NULL DEFAULT 0,
    UNIQUE(connectionId, dateKey)
);
CREATE INDEX IF NOT EXISTS socialCheckIn_connection
    ON socialCheckIn(deleted, connectionId, dateKey DESC, createdAt DESC);

CREATE TABLE IF NOT EXISTS socialPostPreference (
    postId     TEXT NOT NULL PRIMARY KEY,
    liked      INTEGER NOT NULL DEFAULT 0,
    bookmarked INTEGER NOT NULL DEFAULT 0,
    updatedAt  INTEGER NOT NULL
);
