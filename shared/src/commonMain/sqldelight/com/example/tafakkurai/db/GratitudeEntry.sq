-- Local-first Gratitude (Shukr) journal. The client id is the primary key and is the
-- same id the backend stores as client_id, which makes an outbox replay idempotent
-- end to end: writing offline, syncing, and pulling the row back all converge on one
-- entry. `deleted` is a tombstone so a delete survives until the backend confirms it.
CREATE TABLE gratitudeEntry (
    id TEXT NOT NULL PRIMARY KEY,   -- client-generated, stable across sync
    serverId TEXT,                  -- backend uuid once the entry has synced
    mode TEXT NOT NULL,             -- quick | three | reflect
    body TEXT NOT NULL,
    items TEXT NOT NULL,            -- JSON array (3-things mode)
    why TEXT,
    category TEXT NOT NULL,
    mood TEXT,                      -- low | difficult | okay | good | wonderful
    emotions TEXT NOT NULL,         -- JSON array
    photoCount INTEGER NOT NULL DEFAULT 0,
    hasAudio INTEGER NOT NULL DEFAULT 0,
    hasVideo INTEGER NOT NULL DEFAULT 0,
    locationLabel TEXT,
    favourite INTEGER NOT NULL DEFAULT 0,
    entryDate TEXT NOT NULL,        -- local calendar day, "yyyy-MM-dd"
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX gratitudeEntry_date ON gratitudeEntry(deleted, entryDate);
CREATE INDEX gratitudeEntry_category ON gratitudeEntry(deleted, category);

upsert:
INSERT OR REPLACE INTO gratitudeEntry (
    id, serverId, mode, body, items, why, category, mood, emotions,
    photoCount, hasAudio, hasVideo, locationLabel, favourite, entryDate,
    createdAt, updatedAt, deleted
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM gratitudeEntry WHERE deleted = 0 ORDER BY entryDate DESC, createdAt DESC;

selectRecent:
SELECT * FROM gratitudeEntry WHERE deleted = 0 ORDER BY entryDate DESC, createdAt DESC LIMIT ?;

selectById:
SELECT * FROM gratitudeEntry WHERE id = ?;

selectByDate:
SELECT * FROM gratitudeEntry WHERE deleted = 0 AND entryDate = ? ORDER BY createdAt DESC;

selectFavourites:
SELECT * FROM gratitudeEntry WHERE deleted = 0 AND favourite = 1 ORDER BY entryDate DESC;

setFavourite:
UPDATE gratitudeEntry SET favourite = ?, updatedAt = ? WHERE id = ?;

setServerId:
UPDATE gratitudeEntry SET serverId = ? WHERE id = ?;

softDelete:
UPDATE gratitudeEntry SET deleted = 1, updatedAt = ? WHERE id = ?;

purgeDeleted:
DELETE FROM gratitudeEntry WHERE deleted = 1;

activeDays:
SELECT DISTINCT entryDate FROM gratitudeEntry WHERE deleted = 0 ORDER BY entryDate;

countAll:
SELECT count(*) FROM gratitudeEntry WHERE deleted = 0;

categoryCounts:
SELECT category, count(*) AS total FROM gratitudeEntry
WHERE deleted = 0 AND entryDate BETWEEN ? AND ?
GROUP BY category;

moodByDate:
SELECT entryDate, mood FROM gratitudeEntry
WHERE deleted = 0 AND mood IS NOT NULL AND entryDate BETWEEN ? AND ?
ORDER BY createdAt;
