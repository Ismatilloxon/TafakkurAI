-- Local-first productivity tasks. The row is the source of truth; SyncSchema captures
-- mutations and the immutable ActivityEvent written by TaskStore drives cross-feature
-- projections such as Today and progression.
CREATE TABLE task (
    id          TEXT NOT NULL PRIMARY KEY,
    title       TEXT NOT NULL,
    notes       TEXT NOT NULL DEFAULT '',
    categoryId  TEXT NOT NULL DEFAULT 'personal',
    priority    TEXT NOT NULL DEFAULT 'medium',
    dueDate     TEXT NOT NULL DEFAULT '',
    dueTime     TEXT NOT NULL DEFAULT '',
    completedAt INTEGER,
    origin      TEXT NOT NULL DEFAULT 'user',
    createdAt   INTEGER NOT NULL,
    updatedAt   INTEGER NOT NULL,
    deleted     INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX task_due ON task(deleted, dueDate, dueTime, completedAt);

upsert:
INSERT OR REPLACE INTO task (
    id, title, notes, categoryId, priority, dueDate, dueTime, completedAt,
    origin, createdAt, updatedAt, deleted
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM task
WHERE deleted = 0
ORDER BY completedAt IS NOT NULL, dueDate = '', dueDate, dueTime = '', dueTime, createdAt DESC;

selectById:
SELECT * FROM task WHERE id = ?;

selectForDate:
SELECT * FROM task
WHERE deleted = 0 AND dueDate = ?
ORDER BY completedAt IS NOT NULL, dueTime = '', dueTime, createdAt DESC;

setCompleted:
UPDATE task SET completedAt = ?, updatedAt = ? WHERE id = ? AND deleted = 0;

softDelete:
UPDATE task SET deleted = 1, updatedAt = ? WHERE id = ?;

restore:
UPDATE task SET deleted = 0, updatedAt = ? WHERE id = ?;
