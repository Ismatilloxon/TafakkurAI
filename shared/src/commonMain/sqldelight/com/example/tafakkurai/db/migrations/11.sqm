-- v11 → v12: private, local-first Tafakkur Journal source of truth.
--
-- The previous Journal UI rendered hardcoded Data.kt examples and posted new writing
-- directly to a tracker endpoint, so there is no trustworthy local row to migrate.
CREATE TABLE IF NOT EXISTS tafakkurJournalEntry (
    id        TEXT NOT NULL PRIMARY KEY,
    promptId  TEXT NOT NULL,
    moodId    TEXT NOT NULL,
    body      TEXT NOT NULL,
    entryDate TEXT NOT NULL,
    origin    TEXT NOT NULL DEFAULT 'user',
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deleted   INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS tafakkurJournalEntry_date
    ON tafakkurJournalEntry(deleted, entryDate DESC, createdAt DESC);
