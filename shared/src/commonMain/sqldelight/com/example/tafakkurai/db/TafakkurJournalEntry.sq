-- Private, local-first Tafakkur reflections. Stable prompt/mood ids let the same row
-- render in a different language after the user changes the app language. `deleted` is
-- a tombstone so offline deletion converges across devices instead of resurrecting text.
CREATE TABLE tafakkurJournalEntry (
    id        TEXT NOT NULL PRIMARY KEY,
    promptId  TEXT NOT NULL,
    moodId    TEXT NOT NULL,
    body      TEXT NOT NULL,
    entryDate TEXT NOT NULL,
    origin    TEXT NOT NULL DEFAULT 'user',
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deleted   INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX tafakkurJournalEntry_date
    ON tafakkurJournalEntry(deleted, entryDate DESC, createdAt DESC);

upsert:
INSERT OR REPLACE INTO tafakkurJournalEntry (
    id, promptId, moodId, body, entryDate, origin, createdAt, updatedAt, deleted
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM tafakkurJournalEntry
WHERE deleted = 0
ORDER BY entryDate DESC, createdAt DESC;

selectActiveById:
SELECT * FROM tafakkurJournalEntry WHERE id = ? AND deleted = 0;

-- Tombstoned ids are still globally occupied: reusing one would make an offline delete
-- erase an unrelated new reflection when devices converge.
selectById:
SELECT * FROM tafakkurJournalEntry WHERE id = ?;

softDelete:
UPDATE tafakkurJournalEntry SET deleted = 1, updatedAt = ? WHERE id = ? AND deleted = 0;
