-- Private local-first money ledger. Amounts are integer minor units so offline writes never
-- acquire binary floating-point rounding errors. Deletes are tombstones for generic sync.
CREATE TABLE financeTransaction (
    id           TEXT NOT NULL PRIMARY KEY,
    kind         TEXT NOT NULL,
    amountMinor  INTEGER NOT NULL,
    currencyCode TEXT NOT NULL,
    categoryId   TEXT NOT NULL,
    note         TEXT NOT NULL DEFAULT '',
    entryDate    TEXT NOT NULL,
    occurredAt   INTEGER NOT NULL,
    createdAt    INTEGER NOT NULL,
    updatedAt    INTEGER NOT NULL,
    deleted      INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX financeTransaction_date
    ON financeTransaction(deleted, entryDate DESC, occurredAt DESC);

CREATE TABLE financeBudget (
    id           TEXT NOT NULL PRIMARY KEY,
    monthKey     TEXT NOT NULL,
    categoryId   TEXT NOT NULL,
    limitMinor   INTEGER NOT NULL,
    currencyCode TEXT NOT NULL,
    createdAt    INTEGER NOT NULL,
    updatedAt    INTEGER NOT NULL,
    deleted      INTEGER NOT NULL DEFAULT 0,
    UNIQUE(monthKey, categoryId, currencyCode)
);

CREATE INDEX financeBudget_month
    ON financeBudget(deleted, monthKey, currencyCode);

-- Savings goals keep mutable metadata separate from immutable contributions. A row per
-- contribution is what lets generic sync preserve two offline additions instead of resolving
-- them with last-write-wins and losing one person's money movement.
CREATE TABLE financeGoal (
    id           TEXT NOT NULL PRIMARY KEY,
    title        TEXT NOT NULL,
    targetMinor  INTEGER NOT NULL,
    currencyCode TEXT NOT NULL,
    createdAt    INTEGER NOT NULL,
    updatedAt    INTEGER NOT NULL,
    deleted      INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX financeGoal_updated
    ON financeGoal(deleted, updatedAt DESC);

CREATE TABLE financeGoalContribution (
    id            TEXT NOT NULL PRIMARY KEY,
    goalId        TEXT NOT NULL,
    amountMinor   INTEGER NOT NULL,
    currencyCode  TEXT NOT NULL,
    contributionDate TEXT NOT NULL,
    occurredAt    INTEGER NOT NULL,
    createdAt     INTEGER NOT NULL,
    deleted       INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX financeGoalContribution_goal
    ON financeGoalContribution(deleted, goalId, occurredAt DESC);

-- Finance-owned preference rather than a global UI preference. This row synchronises through
-- the generic platform, while ledger values remain in their original currencies.
CREATE TABLE financePreference (
    prefKey    TEXT NOT NULL PRIMARY KEY,
    prefValue  TEXT NOT NULL,
    updatedAt  INTEGER NOT NULL
);

upsertTransaction:
INSERT OR REPLACE INTO financeTransaction (
    id, kind, amountMinor, currencyCode, categoryId, note, entryDate,
    occurredAt, createdAt, updatedAt, deleted
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTransactions:
SELECT * FROM financeTransaction
WHERE deleted = 0
ORDER BY entryDate DESC, occurredAt DESC, createdAt DESC;

selectTransactionById:
SELECT * FROM financeTransaction WHERE id = ?;

softDeleteTransaction:
UPDATE financeTransaction SET deleted = 1, updatedAt = ? WHERE id = ?;

upsertBudget:
INSERT OR REPLACE INTO financeBudget (
    id, monthKey, categoryId, limitMinor, currencyCode, createdAt, updatedAt, deleted
) VALUES (?, ?, ?, ?, ?, ?, ?, 0);

selectBudgets:
SELECT * FROM financeBudget
WHERE deleted = 0
ORDER BY monthKey DESC, categoryId;

selectBudgetByScope:
SELECT * FROM financeBudget
WHERE monthKey = ? AND categoryId = ? AND currencyCode = ?;

softDeleteBudget:
UPDATE financeBudget SET deleted = 1, updatedAt = ? WHERE id = ?;

upsertGoal:
INSERT OR REPLACE INTO financeGoal (
    id, title, targetMinor, currencyCode, createdAt, updatedAt, deleted
) VALUES (?, ?, ?, ?, ?, ?, 0);

selectGoals:
SELECT * FROM financeGoal
WHERE deleted = 0
ORDER BY updatedAt DESC, createdAt DESC;

selectGoalById:
SELECT * FROM financeGoal WHERE id = ?;

softDeleteGoal:
UPDATE financeGoal SET deleted = 1, updatedAt = ? WHERE id = ?;

insertGoalContribution:
INSERT INTO financeGoalContribution (
    id, goalId, amountMinor, currencyCode, contributionDate, occurredAt, createdAt, deleted
) VALUES (?, ?, ?, ?, ?, ?, ?, 0);

selectGoalContributions:
SELECT * FROM financeGoalContribution
WHERE deleted = 0
ORDER BY occurredAt DESC, createdAt DESC;

selectGoalContributionById:
SELECT * FROM financeGoalContribution WHERE id = ?;

putFinancePreference:
INSERT OR REPLACE INTO financePreference(prefKey, prefValue, updatedAt)
VALUES (?, ?, ?);

selectFinancePreference:
SELECT prefValue FROM financePreference WHERE prefKey = ?;
