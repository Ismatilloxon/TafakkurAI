<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Declares the Keychain group the app stores its session tokens in.

	  A device build gets `application-identifier` from the provisioning profile and Keychain
	  access works without this file, but a Simulator build is signed to run locally with no
	  entitlements at all — SecItemAdd/SecItemCopyMatching then fail with errSecMissingEntitlement
	  (-34018) and the session silently fails to survive a relaunch, which looks exactly like the
	  "onboarding comes back every launch" bug this app had.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>

	<!--
	  Sign in with Apple. ASAuthorizationController shows its sheet without this, but the
	  authorization then fails with error 1000 ("The operation couldn't be completed") because
	  the request is unsigned — so the entitlement has to be here AND enabled on the App ID in
	  the developer portal, or the provisioning profile won't carry it.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
