<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Recitation keeps playing when the app is backgrounded or the screen locks. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Dev only: the backend is served over plain HTTP on the local network. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>TafakkurAI connects to the development server running on your local network.</string>
	<!-- Debug and Release provide different values through Xcode build settings. -->
	<key>TafakkurAPIBaseURL</key>
	<string>$(TAFAKKUR_API_BASE_URL)</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TafakkurAI needs access to your photos so you can set a profile picture.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>TafakkurAI reads your sleep stages and duration to show recovery and sleep trends.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>TafakkurAI uses your location to calculate accurate prayer times for where you are.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TafakkurAI uses your location to calculate accurate prayer times for where you are.</string>
</dict>
</plist>
