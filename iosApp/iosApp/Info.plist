<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Recitation keeps playing when the app is backgrounded or the screen locks. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TafakkurAI needs access to your photos so you can set a profile picture.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>TafakkurAI uses your location to calculate accurate prayer times for where you are.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TafakkurAI uses your location to calculate accurate prayer times for where you are.</string>
</dict>
</plist>
